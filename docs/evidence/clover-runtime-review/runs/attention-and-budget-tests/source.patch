+def runtime_reserve_bytes(config):
+    """Price Clover's private clean state and largest permitted transaction."""
+    if getattr(getattr(config, "model_config", None), "model_type", None) != "clover_moe":
+        return 0
+    width = config.clover_max_width
+    if not width:
+        return 0
