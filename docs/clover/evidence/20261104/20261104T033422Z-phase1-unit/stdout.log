    @pytest.mark.parametrize("ps", [8, 128])
    def test_chunked_prefill_conserves_swa_slots(ps):
        # Multi-extend prompt (successive allocate_paged with a growing frontier), unaligned end.
        cm = _mgr(ps, num_pages=32)
