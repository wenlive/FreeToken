    def build_ninja(build_dir: str) -> None:
        """Build the module in the given build directory using ninja."""
        command = ["ninja", "-v"]
        num_workers = os.environ.get("MAX_JOBS", None)
        if num_workers is not None:
            command += ["-j", num_workers]
        if IS_WINDOWS:
